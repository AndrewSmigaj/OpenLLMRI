# Concept MRI Environment Configuration

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# The browser origins allowed to call the API (comma separated): the app's dev server by default.
# The MUD and curl aren't browsers, so this doesn't affect them.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model Configuration
MODEL_NAME=ossb20b
MODEL_CACHE_DIR=data/models/
DEVICE_MAP=auto
USE_NF4_QUANTIZATION=true

# Data Storage
DATA_LAKE_PATH=data/lake/
EXPERIMENTS_PATH=data/experiments/
PARQUET_COMPRESSION=snappy

# Clustering Configuration
DEFAULT_SEED=1
MICROBATCH_SIZE_FLOOR=4
MAX_MEMORY_GB=16

# LLM Configuration (user-supplied)
OPENAI_API_KEY=your-api-key-here
ANTHROPIC_API_KEY=your-api-key-here
LLM_PROVIDER=openai  # openai | anthropic | local
LLM_MODEL=gpt-4

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json

# The MUD's host ports (telnet, web, websocket), read by mud/'s compose, the backend and the app.
MUD_TELNET_PORT=4000
MUD_WEB_PORT=4001
MUD_WS_PORT=4002

# Evennia Agent (used by backend for agent loop — do NOT pass in curl calls)
EVENNIA_AGENT_USER=agent
EVENNIA_AGENT_PASS=change-me

# Development
DEBUG=false
RELOAD=true